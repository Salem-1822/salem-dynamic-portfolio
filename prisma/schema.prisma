// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS_TOOLS
  SECURITY
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  ARCHIVED
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

model Profile {
  id          String   @id @default(cuid())
  fullName    String
  headline    String
  bio         String
  email       String
  phone       String?
  location    String
  githubUrl   String?
  linkedinUrl String?
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
}

model Education {
  id           String    @id @default(cuid())
  institution  String
  degree       String
  fieldOfStudy String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  displayOrder Int       @default(0)
}

model Experience {
  id           String            @id @default(cuid())
  company      String
  position     String
  description  String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean           @default(false)
  displayOrder Int               @default(0)
  skills       ExperienceSkill[]
}

model Skill {
  id           String            @id @default(cuid())
  name         String
  category     SkillCategory
  level        Int?
  icon         String?
  displayOrder Int               @default(0)
  projects     ProjectSkill[]
  experiences  ExperienceSkill[]
}

model Project {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  description  String
  imageUrl     String?
  githubUrl    String?
  liveUrl      String?
  featured     Boolean        @default(false)
  status       ProjectStatus  @default(COMPLETED)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  skills       ProjectSkill[]
}

model CV {
  id         String   @id @default(cuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  fileName   String
  fileUrl    String
  publicId   String
  fileSize   Int
  isActive   Boolean  @default(false)
  uploadedAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Admin {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  role             AdminRole      @default(SUPER_ADMIN)
  isActive         Boolean        @default(true)
  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String?
  createdAt        DateTime       @default(now())
  sessions         AdminSession[]
  cvs              CV[]
  auditLogs        AuditLog[]
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  createdAt  DateTime @default(now())
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model ExperienceSkill {
  experienceId String
  skillId      String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
}
